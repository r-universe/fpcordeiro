[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "choicer"]
	path = choicer
	url = https://github.com/fpcordeiro/choicer
[submodule "dtaudit"]
	path = dtaudit
	url = https://github.com/fpcordeiro/dtaudit
[submodule "tidyaudit"]
	path = tidyaudit
	url = https://github.com/fpcordeiro/tidyaudit
